generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum WorkspaceRole {
  MANAGER
  MEMBER
  VIEWER
}

model Exercice {
  id                    String                 @id @default(uuid())
  nom                   String
  description           String
  imageUrl              String?
  imagesSupplementaires String[]               @default([])
  points                String?
  materiel              String?
  notes                 String?
  critereReussite       String?
  variablesPlus         String                 @default("")
  variablesMinus        String                 @default("")
  duree_minutes         Int?
  nombre_joueurs        Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  entrainements         EntrainementExercice[]
  tags                  Tag[]                  @relation("ExerciseTags")

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([workspaceId])
}

model Tag {
  id               String           @id @default(uuid())
  label            String
  category         String
  color            String?
  level            Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  entrainements    Entrainement[]   @relation("EntrainementTags")
  exercices        Exercice[]       @relation("ExerciseTags")
  situationsMatchs SituationMatch[] @relation("SituationMatchTags")
  echauffements    Echauffement[]   @relation("EchauffementTags")

  parentId String?
  parent   Tag?    @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Tag[]   @relation("TagHierarchy")

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, label, category])
  @@index([createdAt])
  @@index([workspaceId])
  @@index([parentId])
}

model Entrainement {
  id               String                 @id @default(uuid())
  titre            String
  date             DateTime?
  rang             Int?
  imageUrl         String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  echauffementId   String?
  situationMatchId String?
  echauffement     Echauffement?          @relation(fields: [echauffementId], references: [id])
  situationMatch   SituationMatch?        @relation(fields: [situationMatchId], references: [id])
  exercices        EntrainementExercice[]
  tags             Tag[]                  @relation("EntrainementTags")
  lexique          Lexique[]              @relation("EntrainementLexique")

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([echauffementId])
  @@index([situationMatchId])
  @@index([createdAt])
  @@index([workspaceId])
}

model EntrainementExercice {
  id             String       @id @default(uuid())
  entrainementId String
  exerciceId     String
  ordre          Int
  duree          Int?
  notes          String?
  createdAt      DateTime     @default(now())
  entrainement   Entrainement @relation(fields: [entrainementId], references: [id], onDelete: Cascade)
  exercice       Exercice     @relation(fields: [exerciceId], references: [id], onDelete: Cascade)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([entrainementId, exerciceId])
  @@index([entrainementId])
  @@index([exerciceId])
  @@index([createdAt])
  @@index([workspaceId])
}

model Echauffement {
  id                    String             @id @default(uuid())
  nom                   String
  description           String?
  imageUrl              String?
  imagesSupplementaires String[]           @default([])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  blocs                 BlocEchauffement[]
  tags                  Tag[]              @relation("EchauffementTags")
  entrainements         Entrainement[]

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([workspaceId])
}

model BlocEchauffement {
  id             String       @id @default(uuid())
  echauffementId String
  ordre          Int
  titre          String
  repetitions    String?
  temps          String?
  informations   String?
  fonctionnement String?
  notes          String?
  createdAt      DateTime     @default(now())
  echauffement   Echauffement @relation(fields: [echauffementId], references: [id], onDelete: Cascade)

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([echauffementId, ordre])
  @@index([echauffementId])
  @@index([createdAt])
  @@index([workspaceId])
}

model SituationMatch {
  id                    String         @id @default(uuid())
  nom                   String?
  type                  String
  description           String?
  temps                 String?
  imageUrl              String?
  imagesSupplementaires String[]       @default([])
  nombre_joueurs        Int?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  entrainements         Entrainement[]
  tags                  Tag[]          @relation("SituationMatchTags")

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([workspaceId])
}

model Lexique {
  id         String   @id @default(uuid())
  terme      String
  definition String
  categorie  String
  motImage   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entrainements Entrainement[] @relation("EntrainementLexique")

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([workspaceId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  nom       String
  prenom    String?
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  isTester  Boolean  @default(false)
  iconUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces      WorkspaceUser[]
  espacePersonnel Workspace[]     @relation("EspacePersonnel")
  envoisEmis      Envoi[]         @relation("EnvoisEmis")
  envoisRecus     Envoi[]         @relation("EnvoisRecus")

  @@index([createdAt])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  isBase    Boolean  @default(false)
  /// Espace personnel : l'utilisateur qui en est le propriétaire (null = espace collectif)
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner                 User?                  @relation("EspacePersonnel", fields: [ownerId], references: [id], onDelete: SetNull)
  members               WorkspaceUser[]
  exercices             Exercice[]
  tags                  Tag[]
  entrainements         Entrainement[]
  entrainementExercices EntrainementExercice[]
  echauffements         Echauffement[]
  blocsEchauffement     BlocEchauffement[]
  situationsMatch       SituationMatch[]
  lexiques              Lexique[]
}

model WorkspaceUser {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

enum StatutEnvoi {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

/// Envoi d'un element (exercice, echauffement, situation) d'un utilisateur a un autre.
/// Le contenu est une photo de la fiche au moment de l'envoi : l'element recu ne change pas
/// si l'expediteur modifie ou supprime son original ensuite.
model Envoi {
  id            String      @id @default(uuid())
  famille       String
  nom           String
  contenu       Json
  message       String?
  statut        StatutEnvoi @default(EN_ATTENTE)
  createdAt     DateTime    @default(now())
  decideAt      DateTime?
  resultatVu    Boolean     @default(false)
  elementCreeId String?
  espaceCibleId String?

  expediteurId   String
  expediteur     User   @relation("EnvoisEmis", fields: [expediteurId], references: [id], onDelete: Cascade)
  destinataireId String
  destinataire   User   @relation("EnvoisRecus", fields: [destinataireId], references: [id], onDelete: Cascade)

  @@index([destinataireId, statut])
  @@index([expediteurId])
  @@index([createdAt])
}

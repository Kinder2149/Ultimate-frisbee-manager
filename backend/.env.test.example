# =======================================================================
# Environnement des tests automatises
# =======================================================================
# Base PostgreSQL locale et jetable, definie dans docker-compose.test.yml.
# Aucun secret ici : ces identifiants sont locaux et sans valeur.
#
# ⚠️ Les tests REINITIALISENT cette base a chaque execution.
#    Ne jamais y faire pointer une base contenant des donnees a garder.
#    Le garde-fou de tests/setup.js refuse toute cible qui ne serait ni
#    locale, ni nommee « test ».
#
#   Demarrer la base : docker compose -f docker-compose.test.yml up -d
# =======================================================================

NODE_ENV=test

DATABASE_URL="postgresql://ufm_test:ufm_test@localhost:5433/ufm_test"
DIRECT_URL="postgresql://ufm_test:ufm_test@localhost:5433/ufm_test"

# Valeurs factices : les tests ne contactent aucun service externe.
SUPABASE_PROJECT_REF="test_project_ref"
SUPABASE_URL="https://test_project_ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="test_service_role_key"
CLOUDINARY_URL="cloudinary://000000000000000:test_secret@test_cloud"

RATE_LIMIT_ENABLED=false
